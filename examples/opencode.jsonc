{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // Use the built package directory, or run bin/autoskill.mjs install to configure it.
      "package": "D:/plugins/opencode-autoskill",
      "options": {
        "enabled": true,
        "mode": "auto", // "draft" saves candidates automatically; publish with the drafts publish CLI command.
        "language": "zh-CN",
        // Retrieve for each new task; automatically load bodies only when relevance, prerequisites, and protection checks pass.
        "reuseEnabled": true,
        "reuseCandidateLimit": 5,
        "reuseAutoLoadLimit": 2,
        "reuseMinScore": 0.16,
        "reuseAutoLoadScore": 0.62,
        "reuseStaleAfterDays": 180,
        "reuseMaxContextChars": 16000,
        "reuseMaxSkillChars": 6000,
        "reuseTimeoutMs": 5000,
        // All automatic candidates need substantive evidence and the minimum score; tool/failure counts alone do not qualify.
        "minComplexityScore": 11,
        "debounceMs": 2000,
        "cooldownMs": 60000,
        "reviewTimeoutMs": 90000,
        "maxAttempts": 2,
        "retryBaseMs": 5000,
        "retryMaxMs": 300000,
        "minConfidence": 0.85,
        "maxSkillChars": 16000,
        "maxTranscriptChars": 60000,
        "maxToolOutputChars": 6000,
        "maxPromptChars": 80000,
        "maxEstimatedInputTokens": 40000,
        "relevantSkillLimit": 8,
        "maxManagedSkills": 100,
        "maxReviewsPerDay": 20,
        "maxGlobalReviewsPerDay": 100,
        // Estimated input-token budgets; the host does not report actual usage, so these do not guarantee exact cost.
        "maxEstimatedTokensPerDay": 250000,
        "maxGlobalEstimatedTokensPerDay": 1000000,
        "providerAllowlist": [], // When nonempty, send distillation requests only to these providers.
        "excludeTools": [],
        "excludeSessions": [],
        // A custom array replaces this configured list; built-in sensitive-file exclusions always apply.
        "excludeFiles": [".env", ".env.*", "*.pem", "*.key", "**/credentials*", "**/auth.json", "**/secrets/**"],
        "sensitivePatterns": [], // Literal fragments of at least 3 characters; not regular expressions.
        "storeEvidence": "redacted"
        // Optional reviewer model; defaults to the task model.
        // ,"model": { "providerID": "your-provider", "id": "your-model" }
        // Optional cross-project budget directory; defaults to the user-private state directory.
        // ,"globalStateDirectory": "D:/private/opencode-autoskill"
      }
    }
  ]
}
