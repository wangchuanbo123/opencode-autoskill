{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // 改为构建后的包目录；也可运行 bin/autoskill.mjs install 自动配置。
      "package": "D:/plugins/opencode-autoskill",
      "options": {
        "enabled": true,
        "mode": "auto", // "draft" 自动提炼为候选，通过 CLI drafts publish 发布
        "language": "zh-CN",
        // 每个新任务检索；仅高相关、前提明确且通过保护检查时自动加载正文。
        "reuseEnabled": true,
        "reuseCandidateLimit": 5,
        "reuseAutoLoadLimit": 2,
        "reuseMinScore": 0.16,
        "reuseAutoLoadScore": 0.62,
        "reuseStaleAfterDays": 180,
        "reuseMaxContextChars": 16000,
        "reuseMaxSkillChars": 6000,
        "reuseTimeoutMs": 5000,
        // 所有自动候选必须有实质证据并达到评分；工具次数和失败次数不直接触发。
        "minComplexityScore": 11,
        "debounceMs": 2000,
        "cooldownMs": 60000,
        "reviewTimeoutMs": 90000,
        "maxAttempts": 2,
        "retryBaseMs": 5000,
        "retryMaxMs": 300000,
        "minConfidence": 0.85,
        "maxSkillChars": 16000,
        "maxTranscriptChars": 60000,
        "maxToolOutputChars": 6000,
        "maxPromptChars": 80000,
        "maxEstimatedInputTokens": 40000,
        "relevantSkillLimit": 8,
        "maxManagedSkills": 100,
        "maxReviewsPerDay": 20,
        "maxGlobalReviewsPerDay": 100,
        // 估算输入 token 预算；宿主不提供实际 usage，不能据此保证精确金额。
        "maxEstimatedTokensPerDay": 250000,
        "maxGlobalEstimatedTokensPerDay": 1000000,
        "providerAllowlist": [], // 非空时只向列出的 provider 发送提炼请求
        "excludeTools": [],
        "excludeSessions": [],
        // 自定义数组替换配置列表；工具内置的敏感文件排除规则始终生效。
        "excludeFiles": [".env", ".env.*", "*.pem", "*.key", "**/credentials*", "**/auth.json", "**/secrets/**"],
        "sensitivePatterns": [], // 字面片段，至少3个字符；不解释为正则
        "storeEvidence": "redacted"
        // 可选：指定复盘模型；默认沿用任务模型。
        // ,"model": { "providerID": "your-provider", "id": "your-model" }
        // 可选：跨项目预算目录；默认用户私有状态目录。
        // ,"globalStateDirectory": "D:/private/opencode-autoskill"
      }
    }
  ]
}
