{
  "name": "opencode-autoskill",
  "version": "0.4.0",
  "description": "Distill verified agent tasks into reusable project skills across OpenCode, Claude Code, Codex, Gemini CLI and Cursor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangchuanbo123/opencode-autoskill.git"
  },
  "homepage": "https://github.com/wangchuanbo123/opencode-autoskill#readme",
  "bugs": {
    "url": "https://github.com/wangchuanbo123/opencode-autoskill/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core.js",
    "./adapters": "./dist/adapters/events.js",
    "./portable": "./dist/portable/runtime.js"
  },
  "bin": {
    "opencode-autoskill": "./bin/autoskill.mjs",
    "autoskill": "./bin/autoskill.mjs"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "examples",
    "scripts/smoke.mjs",
    "scripts/reuse-smoke.mjs",
    "scripts/portable-smoke.mjs",
    "scripts/evaluate.mjs",
    "scripts/package-check.mjs",
    "evaluation",
    "README.md",
    "README.zh-CN.md",
    "CROSS_PLATFORM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:reuse": "node scripts/reuse-smoke.mjs",
    "smoke:portable": "node scripts/portable-smoke.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "package-check": "node scripts/package-check.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "claude-code",
    "codex",
    "gemini",
    "cursor",
    "mcp",
    "plugin",
    "skills",
    "learning"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@opencode/client": "2.2.7",
    "@opencode/plugin": "2.2.7",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
